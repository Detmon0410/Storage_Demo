generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Category {
  categoryId   Int       @id @default(autoincrement()) @map("category_id")
  categoryCode String    @unique @map("category_code")
  categoryName String    @map("category_name")
  description  String?
  isActive     Boolean   @default(true) @map("is_active")
  products     Product[]

  @@map("categories")
}

model Supplier {
  supplierId   Int           @id @default(autoincrement()) @map("supplier_id")
  supplierCode String        @unique @map("supplier_code")
  supplierName String        @map("supplier_name")
  country      String?
  contactName  String?       @map("contact_name")
  email        String?
  phone        String?
  status       String        @default("active")
  products     Product[]
  importOrders ImportOrder[]

  @@map("suppliers")
}

model Product {
  productId      Int      @id @default(autoincrement()) @map("product_id")
  productCode    String   @unique @map("product_code")
  productName    String   @map("product_name")
  categoryId     Int      @map("category_id")
  supplierId     Int      @map("supplier_id")
  unit           String
  stockQty       Int      @default(0) @map("stock_qty")
  minStock       Int      @default(0) @map("min_stock")
  unitPrice      Decimal  @map("unit_price") @db.Decimal(12, 2)
  costPrice      Decimal? @map("cost_price") @db.Decimal(12, 2)
  suggestedPrice Decimal? @map("suggested_price") @db.Decimal(12, 2)
  abvPercent     Decimal? @map("abv_percent") @db.Decimal(5, 2)
  packageSizeMl  Int?     @map("package_size_ml")
  currency       String   @default("USD")
  status         String   @default("active")
  description    String?

  category          Category           @relation(fields: [categoryId], references: [categoryId])
  supplier          Supplier           @relation(fields: [supplierId], references: [supplierId])
  stockTransactions StockTransaction[]
  salesOrderItems   SalesOrderItem[]
  inventoryLots     InventoryStock[]
  importOrderItems  ImportOrderItem[]
  licenses          License[]

  @@map("products")
}

model Company {
  companyId Int    @id @default(autoincrement()) @map("company_id")
  legalName String @map("legal_name")
  taxId     String @map("tax_id")
  address   String

  licenses License[]

  @@map("companies")
}

enum TransactionType {
  IN
  OUT
  ADJUSTMENT
}

model StockTransaction {
  transactionId    Int             @id @default(autoincrement()) @map("transaction_id")
  transactionNo    String          @unique @map("transaction_no")
  productId        Int             @map("product_id")
  transactionType  TransactionType @map("transaction_type")
  quantity         Int
  transactionDate  DateTime        @default(now()) @map("transaction_date")
  referenceNo      String?         @map("reference_no")
  note             String?
  inventoryStockId Int?            @map("inventory_stock_id")

  product        Product         @relation(fields: [productId], references: [productId])
  inventoryStock InventoryStock? @relation(fields: [inventoryStockId], references: [inventoryStockId], onDelete: SetNull)

  @@map("stock_transactions")
}

model ImportOrder {
  importOrderId  Int      @id @default(autoincrement()) @map("import_order_id")
  orderNo        String   @unique @map("order_no")
  supplierId     Int      @map("supplier_id")
  country        String
  incoterms      String
  orderDate      DateTime @map("order_date") @db.Date
  etaDate        DateTime @map("eta_date") @db.Date
  skuItemCount   Int      @map("sku_item_count")
  totalValue     Decimal  @map("total_value") @db.Decimal(14, 2)
  taxTotal       Decimal  @default(0) @map("tax_total") @db.Decimal(14, 2)
  status         String
  approver       String?
  customsEntryNo String?  @map("customs_entry_no")
  createdById    Int?     @map("created_by_id")

  supplier  Supplier          @relation(fields: [supplierId], references: [supplierId])
  items     ImportOrderItem[]
  createdBy User?             @relation("CreatedImportOrders", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("import_orders")
}

model ImportOrderItem {
  importOrderItemId Int     @id @default(autoincrement()) @map("import_order_item_id")
  importOrderId     Int     @map("import_order_id")
  productId         Int     @map("product_id")
  quantity          Int
  unitPrice         Decimal @map("unit_price") @db.Decimal(12, 2)
  taxRate           Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount         Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  subtotal          Decimal @db.Decimal(14, 2)

  importOrder   ImportOrder      @relation(fields: [importOrderId], references: [importOrderId], onDelete: Cascade)
  product       Product          @relation(fields: [productId], references: [productId])
  inventoryLots InventoryStock[]

  @@map("import_order_items")
}

model License {
  licenseId   Int      @id @default(autoincrement()) @map("license_id")
  licenseNo   String   @unique @map("license_no")
  licenseType String   @map("license_type")
  holderName  String   @map("holder_name")
  category    String
  issueDate   DateTime @map("issue_date") @db.Date
  expiryDate  DateTime @map("expiry_date") @db.Date

  companyId Int?     @map("company_id")
  productId Int?     @map("product_id")
  company   Company? @relation(fields: [companyId], references: [companyId])
  product   Product? @relation(fields: [productId], references: [productId])

  @@map("licenses")
}

enum CustomerLicenseStatus {
  ACTIVE
  EXPIRED
  REVOKED
  SUSPENDED
  PENDING
}

model CustomerLicense {
  customerLicenseId Int                   @id @default(autoincrement()) @map("customer_license_id")
  customerId        Int                   @map("customer_id")
  licenseNumber     String                @unique @map("license_number")
  licenseType       String                @map("license_type")
  applicableChannel String?               @map("applicable_channel")
  issueDate         DateTime              @map("issue_date") @db.Date
  expiryDate        DateTime              @map("expiry_date") @db.Date
  status            CustomerLicenseStatus @default(PENDING)
  documentUrl       String?               @map("document_url")
  notes             String?

  createdBy       String?   @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedBy       String?   @map("updated_by")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  statusChangedBy String?   @map("status_changed_by")
  statusChangedAt DateTime? @map("status_changed_at")

  renewedFromId Int?             @unique @map("renewed_from_id")
  renewedFrom   CustomerLicense? @relation("LicenseRenewal", fields: [renewedFromId], references: [customerLicenseId], onDelete: Restrict)
  renewedTo     CustomerLicense? @relation("LicenseRenewal")

  customer    Customer     @relation(fields: [customerId], references: [customerId])
  salesOrders SalesOrder[]

  @@map("customer_licenses")
}

model Customer {
  customerId       Int     @id @default(autoincrement()) @map("customer_id")
  customerCode     String  @unique @map("customer_code")
  customerName     String  @map("customer_name")
  channelType      String  @map("channel_type")
  creditLimit      Decimal @map("credit_limit") @db.Decimal(14, 2)
  currentBalance   Decimal @map("current_balance") @db.Decimal(14, 2)
  availableCredit  Decimal @map("available_credit") @db.Decimal(14, 2)
  standardDiscount Decimal @map("standard_discount") @db.Decimal(5, 2)
  creditStatus     String  @map("credit_status")

  licenses    CustomerLicense[]
  salesOrders SalesOrder[]

  @@map("customers")
}

model SalesOrder {
  salesOrderId     Int     @id @default(autoincrement()) @map("sales_order_id")
  orderNo          String  @unique @map("order_no")
  customerId       Int     @map("customer_id")
  netValue         Decimal @map("net_value") @db.Decimal(14, 2)
  taxTotal         Decimal @default(0) @map("tax_total") @db.Decimal(14, 2)
  deliveryStatus   String  @map("delivery_status")
  invoiceNo        String  @map("invoice_no")
  approver         String?
  createdById      Int?    @map("created_by_id")
  requiresApproval Boolean @default(false) @map("requires_approval")
  updatedById      Int?    @map("updated_by_id")

  customerLicenseId     Int?      @map("customer_license_id")
  licenseNumberSnapshot String?   @map("license_number_snapshot")
  licenseTypeSnapshot   String?   @map("license_type_snapshot")
  licenseExpirySnapshot DateTime? @map("license_expiry_snapshot") @db.Date

  customer        Customer         @relation(fields: [customerId], references: [customerId])
  customerLicense CustomerLicense? @relation(fields: [customerLicenseId], references: [customerLicenseId], onDelete: Restrict)
  items           SalesOrderItem[]
  createdBy       User?            @relation("CreatedSalesOrders", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?            @relation("UpdatedSalesOrders", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("sales_orders")
}

model SalesOrderItem {
  salesOrderItemId Int     @id @default(autoincrement()) @map("sales_order_item_id")
  salesOrderId     Int     @map("sales_order_id")
  productId        Int     @map("product_id")
  quantity         Int
  unitPrice        Decimal @map("unit_price") @db.Decimal(12, 2)
  discount         Decimal @db.Decimal(5, 2)
  taxRate          Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount        Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  netValue         Decimal @map("net_value") @db.Decimal(14, 2)
  inventoryStockId Int     @map("inventory_stock_id")

  salesOrder     SalesOrder     @relation(fields: [salesOrderId], references: [salesOrderId], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [productId])
  inventoryStock InventoryStock @relation(fields: [inventoryStockId], references: [inventoryStockId], onDelete: Restrict)

  @@map("sales_order_items")
}

model InventoryStock {
  inventoryStockId  Int      @id @default(autoincrement()) @map("inventory_stock_id")
  productId         Int      @map("product_id")
  importOrderItemId Int?     @map("import_order_item_id")
  lotBatch          String   @map("lot_batch")
  receivedDate      DateTime @map("received_date") @db.Date
  quantityOnHand    Int      @map("quantity_on_hand")
  stockAgeDays      Int      @map("stock_age_days")
  stockStatus       String   @map("stock_status")
  warehouse         String

  product         Product          @relation(fields: [productId], references: [productId])
  importOrderItem ImportOrderItem? @relation(fields: [importOrderItemId], references: [importOrderItemId], onDelete: SetNull)

  salesOrderItems   SalesOrderItem[]
  stockTransactions StockTransaction[]

  @@unique([productId, lotBatch])
  @@map("inventory_stock")
}

model DashboardKpi {
  dashboardKpiId Int     @id @default(autoincrement()) @map("dashboard_kpi_id")
  metricName     String  @unique @map("metric_name")
  currentValue   Decimal @map("current_value") @db.Decimal(14, 2)
  unit           String
  monthTrend     String  @map("month_trend")

  @@map("dashboard_kpis")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id            Int            @id @default(autoincrement()) @map("user_id")
  username      String         @unique
  passwordHash  String         @map("password_hash")
  status        UserStatus     @default(ACTIVE)
  createdAt     DateTime       @default(now()) @map("created_at")
  refreshTokens RefreshToken[]
  userRoles           UserRole[]
  auditLogs           AuditLog[]
  createdImportOrders ImportOrder[] @relation("CreatedImportOrders")
  createdSalesOrders  SalesOrder[]  @relation("CreatedSalesOrders")
  updatedSalesOrders  SalesOrder[]  @relation("UpdatedSalesOrders")

  @@map("users")
}

model RefreshToken {
  id        Int       @id @default(autoincrement()) @map("refresh_token_id")
  tokenHash String    @unique @map("token_hash")
  userId    Int       @map("user_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

model Role {
  roleId          Int              @id @default(autoincrement()) @map("role_id")
  roleCode        String           @unique @map("role_code")
  roleName        String           @map("role_name")
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  permissionId     Int              @id @default(autoincrement()) @map("permission_id")
  permissionCode   String           @unique @map("permission_code")
  permissionName   String           @map("permission_name")
  rolePermissions  RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId Int  @map("user_id")
  roleId Int  @map("role_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [roleId], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [roleId], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [permissionId], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AuditLog {
  auditLogId Int      @id @default(autoincrement()) @map("audit_log_id")
  entity     String
  entityId   String   @map("entity_id")
  action     String
  userId     Int?     @map("user_id")
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
